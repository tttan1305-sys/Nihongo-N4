    },
    {
     "group": "Nhóm II",
     "ruleVi": "bỏ ます + る",
     "example": "{食|た}べます → {食|た}べる"
    },
    {
     "group": "Nhóm III",
     "ruleVi": "します → する, {来|き}ます → {来|く}る",
     "example": "{来|き}ます → {来|く}る"
