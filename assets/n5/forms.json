 "forms": [
  {
   "id": "masu",
   "name": "Thể ます",
   "nameJa": "ます{形|けい}",
   "lesson": "Bài 4–5",
   "usesVi": "Cách nói lịch sự, dùng với người không thân, ở chỗ làm. Phủ định ～ません, quá khứ ～ました, quá khứ phủ định ～ませんでした.",
   "rules": [
    {
     "group": "Nhóm I",
     "ruleVi": "đổi đuôi hàng う sang hàng い + ます",
     "example": "{書|か}く → {書|か}きます"
    },
    {
     "group": "Nhóm II",
     "ruleVi": "bỏ る + ます",
     "example": "{食|た}べる → {食|た}べます"
    },
    {
     "group": "Nhóm III",
     "ruleVi": "する → します, {来|く}る → {来|き}ます",
     "example": "{勉強|べんきょう}する → {勉強|べんきょう}します"
    }
   ],
   "examples": [
    {
     "id": "f-masu-1",
     "ja": "{毎朝|まいあさ}　コーヒーを　{飲|の}みます。",
     "vi": "Mỗi sáng tôi uống cà phê."
    },
    {
     "id": "f-masu-2",
     "ja": "きのう　{会社|かいしゃ}へ　{行|い}きませんでした。",
     "vi": "Hôm qua tôi đã không đi làm."
    }
   ],
   "table": [
    "masu",
    "masen",
    "mashita"
   ]
  },
  {
   "id": "te",
   "name": "Thể て",
   "nameJa": "て{形|けい}",
   "lesson": "Bài 14",
   "usesVi": "Nhờ vả (～てください), đang làm (～ています), nối hành động (～て、～), xin phép (～てもいいです), cấm (～てはいけません).",
   "rules": [
    {
     "group": "Nhóm I",
     "ruleVi": "う・つ・る → って",
     "example": "{買|か}う → {買|か}って、{待|ま}つ → {待|ま}って"
    },
    {
     "group": "Nhóm I",
     "ruleVi": "む・ぶ・ぬ → んで",
     "example": "{飲|の}む → {飲|の}んで、{遊|あそ}ぶ → {遊|あそ}んで"
    },
    {
     "group": "Nhóm I",
     "ruleVi": "く → いて, ぐ → いで (ngoại lệ: {行|い}く → {行|い}って)",
     "example": "{書|か}く → {書|か}いて、{泳|およ}ぐ → {泳|およ}いで"
    },
    {
     "group": "Nhóm I",
     "ruleVi": "す → して",
     "example": "{話|はな}す → {話|はな}して"
    },
    {
     "group": "Nhóm II",
     "ruleVi": "bỏ る + て",
     "example": "{見|み}る → {見|み}て"
    },
    {
     "group": "Nhóm III",
     "ruleVi": "する → して, {来|く}る → {来|き}て",
     "example": "{来|く}る → {来|き}て"
    }
   ],
   "examples": [
    {
     "id": "f-te-1",
     "ja": "すみません、ちょっと　{待|ま}って　ください。",
     "vi": "Xin lỗi, vui lòng chờ một chút."
    },
    {
     "id": "f-te-2",
     "ja": "{今|いま}　{会議|かいぎ}の　{資料|しりょう}を　{読|よ}んで　います。",
     "vi": "Bây giờ tôi đang đọc tài liệu họp."
    }
   ],
   "table": [
    "te"
   ]
  },
  {
   "id": "nai",
   "name": "Thể ない",
   "nameJa": "ない{形|けい}",
   "lesson": "Bài 17",
   "usesVi": "Phủ định thân mật. Dùng trong ～ないでください (xin đừng), ～なければなりません (phải), ～なくてもいいです (không cần).",
   "rules": [
    {
     "group": "Nhóm I",
     "ruleVi": "đổi đuôi hàng う sang hàng あ + ない (う → わない)",
     "example": "{書|か}く → {書|か}かない、{買|か}う → {買|か}わない"
    },
    {
     "group": "Nhóm II",
     "ruleVi": "bỏ る + ない",
     "example": "{寝|ね}る → {寝|ね}ない"
    },
    {
     "group": "Nhóm III",
     "ruleVi": "する → しない, {来|く}る → {来|こ}ない",
     "example": "{来|く}る → {来|こ}ない"
    }
   ],
   "examples": [
    {
     "id": "f-nai-1",
     "ja": "ここで　たばこを　{吸|す}わないで　ください。",
