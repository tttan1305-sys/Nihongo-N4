{
 "groups": [
  {
   "name": "Nhóm I",
   "descVi": "Đuôi thể ます thuộc hàng い: {書|か}きます、{飲|の}みます、{帰|かえ}ります. Chú ý: {帰|かえ}る、{入|はい}る、{走|はし}る、{知|し}る、{切|き}る là nhóm I dù trông giống nhóm II."
  },
  {
   "name": "Nhóm II",
   "descVi": "Đuôi thể ます thuộc hàng え, và một số từ hàng い: {食|た}べます、{寝|ね}ます、{見|み}ます、{起|お}きます."
  },
  {
   "name": "Nhóm III",
   "descVi": "Chỉ có する (và danh từ + する như {勉強|べんきょう}する) và {来|く}る."
  }
 ],
